    {"scope":["support.other.variable","string.other.link"],"settings":{"foreground":"#A93F55"}},
    {"scope":["constant.numeric","constant.language","support.constant","constant.character","constant.escape","variable.parameter","keyword.other.unit","keyword.other"],"settings":{"foreground":"#9A4A00","fontStyle":"italic"}},
