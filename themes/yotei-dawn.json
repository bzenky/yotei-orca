    {"scope":["support.type.property-name.css","support.type.property-name.sass","support.type.property-name.scss","support.type.property-name.less","support.type.property-name.stylus","support.type.property-name.postcss"],"settings":{"foreground":"#A93F55","fontStyle":"italic"}},
    {"scope":["entity.name.module.js","variable.import.parameter.js","variable.other.class.js"],"settings":{"foreground":"#A93F55"}},
    {"scope":"variable.language","settings":{"foreground":"#A93F55","fontStyle":"italic"}},
    {"scope":"entity.name.method.js","settings":{"foreground":"#256D85","fontStyle":"italic"}},
    {"scope":"variable.function.constructor","settings":{"foreground":"#256D85"}},
    {"scope":"entity.other.attribute-name","settings":{"foreground":"#347F73","fontStyle":"italic"}},
