    {"scope":"markup.bold","settings":{"foreground":"#A93F55","fontStyle":"bold"}},
    {"scope":"markup.underline","settings":{"foreground":"#B54800","fontStyle":"underline"}},
    {"scope":"markup.quote","settings":{"fontStyle":"italic"}},
    {"scope":"string.other.link.title.markdown","settings":{"foreground":"#256D85"}},
    {"scope":"string.other.link.description.title.markdown","settings":{"foreground":"#8F3FA8"}},
    {"scope":"constant.other.reference.link.markdown","settings":{"foreground":"#9A4A00"}},
    {"scope":"markup.raw.block","settings":{"foreground":"#8F3FA8"}},
    {"scope":"markup.raw.block.fenced.markdown","settings":{"foreground":"#8A748F"}},
