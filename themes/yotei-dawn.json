    {"scope":"string.regexp","settings":{"foreground":"#2B7F9F"}},
    {"scope":"constant.character.escape","settings":{"foreground":"#2B7F9F"}},
    {"scope":["*url*","*link*","*uri*"],"settings":{"fontStyle":"underline"}},
    {"scope":"string.unquoted.label.js","settings":{"foreground":"#A93F55","fontStyle":"italic"}},
    {"scope":"support.type.property-name.json","settings":{"foreground":"#8F3FA8"}},
